# Copier en .env et remplir (le fichier .env ne doit jamais être poussé).
# Clé d'administration (création des clés des clubs) : 32 caractères au moins,
# par exemple :  openssl rand -hex 32
BP_ADMIN_KEY=
# Adresse e-mail du premier administrateur : son inscription sur le site
# est validée d'office et lui donne l'interface d'administration.
BP_ADMIN_EMAIL=
# Ports locaux (127.0.0.1) relayés par Apache
BP_PORT=8090
SITE_PORT=8091
